DATABASE_URL=postgresql+psycopg2://reelinvesting:reelinvesting@localhost:5432/reelinvesting

DO_SPACES_ENDPOINT=https://<region>.digitaloceanspaces.com
DO_SPACES_REGION=<region>
DO_SPACES_BUCKET=<bucket-name>
DO_SPACES_ACCESS_KEY_ID=<your-access-key>
DO_SPACES_SECRET_ACCESS_KEY=<your-secret-key>

NEWS_INGESTION_MODE=mock
INGESTION_INTERVAL_SECONDS=300
RUN_ON_STARTUP=true

API_HOST=0.0.0.0
API_PORT=8000

ENABLE_MOCK_NEWS=true
ENABLE_MOCK_AGITATORS=true

# ---------------------------------------------------------------------------
# Alpaca News (intelligence only — no trading, no orders, no broker access)
# Get your free API keys at: https://alpaca.markets
# ---------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ENABLE_ALPACA_NEWS=false
ALPACA_NEWS_SYMBOLS=AAPL,MSFT,NVDA,TSLA,SPY,QQQ,BTCUSD,ETHUSD
ALPACA_NEWS_LIMIT=20
